<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <!-- Video. Drawn through a transform so it can be letterboxed or warped onto a window. -->
    <TextureView
        android:id="@+id/video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Black cover over the video until a clip's first frame is drawn. The
         video view itself must stay visible, or it never gets a surface. -->
    <View
        android:id="@+id/shutter"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black" />

    <dev.scenesync.player.CalibrationView
        android:id="@+id/calibration"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Pairing code and status. Hidden during normal playback; any remote key shows it briefly. -->
    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC000000"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFF97316"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:textColor="#FFFFFFFF"
            android:textSize="72sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:maxWidth="720dp"
            android:textColor="#FFDDDDDD"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/server_input"
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="http://192.168.1.10:8080"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF888888"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
