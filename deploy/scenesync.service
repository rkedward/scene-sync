# systemd unit for the SceneSync server on a Raspberry Pi.
# deploy/install.sh installs it; see docs/operations.md.
# The dashboard password is generated on first start and saved in
# /var/lib/scenesync/admin_password (edit that file and restart to change it).
# Logs: journalctl -u scenesync -f
[Unit]
Description=SceneSync server
After=network-online.target
Wants=network-online.target

[Service]
User=scenesync
WorkingDirectory=/var/lib/scenesync
Environment=SCENESYNC_DATA_DIR=/var/lib/scenesync
Environment=SCENESYNC_LISTEN=0.0.0.0:8080
ExecStart=/usr/local/bin/scenesync-server
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
