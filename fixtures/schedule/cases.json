{
  "description": "Shared schedule-engine test vectors. Every engine implementation (Rust core, Android player) must produce `expect` for each case. Times in `now`, `anchor`, and `issued_at` are UTC. 2026-10-30 is a Friday; US DST ends 2026-11-01 at 02:00 local.",
  "durations_ms": {
    "talking-pumpkin": 60000,
    "ghost": 30000,
    "scene-x": 120000,
    "bats": 45000
  },
  "schedules": {
    "evening": {
      "schedule_id": "evening-effects",
      "revision": 12,
      "timezone": "America/Denver",
      "rules": [
        { "id": "pumpkin-evening", "days": ["fri", "sat"], "start": "19:00", "end": "22:00",
          "action": { "type": "loop", "media_id": "talking-pumpkin" } },
        { "id": "ghost-appearance", "days": ["fri", "sat"], "at": "19:15",
          "action": { "type": "play_once", "media_id": "ghost" }, "priority": 10 }
      ]
    },
    "evening-join-late": {
      "schedule_id": "evening-effects",
      "revision": 13,
      "timezone": "America/Denver",
      "rules": [
        { "id": "pumpkin-evening", "days": ["fri", "sat"], "start": "19:00", "end": "22:00",
          "action": { "type": "loop", "media_id": "talking-pumpkin" } },
        { "id": "ghost-appearance", "days": ["fri", "sat"], "at": "19:15",
          "action": { "type": "play_once", "media_id": "ghost" }, "late_policy": "join_late" }
      ]
    },
    "evening-ended": {
      "schedule_id": "evening-effects",
      "revision": 14,
      "timezone": "America/Denver",
      "end_date": "2026-10-30",
      "rules": [
        { "id": "pumpkin-evening", "days": ["fri", "sat"], "start": "19:00", "end": "22:00",
          "action": { "type": "loop", "media_id": "talking-pumpkin" } }
      ]
    },
    "late-night": {
      "schedule_id": "late-night",
      "revision": 1,
      "timezone": "America/Denver",
      "rules": [
        { "id": "bats-overnight", "days": ["sat"], "start": "22:00", "end": "02:00",
          "action": { "type": "loop", "media_id": "bats" } }
      ]
    },
    "overlap": {
      "schedule_id": "overlap",
      "revision": 1,
      "timezone": "America/Denver",
      "rules": [
        { "id": "first", "start": "18:00", "end": "23:00", "action": { "type": "loop", "media_id": "talking-pumpkin" } },
        { "id": "second", "start": "20:00", "end": "21:00", "action": { "type": "loop", "media_id": "bats" } },
        { "id": "same-start-a", "start": "17:00", "end": "17:30", "action": { "type": "loop", "media_id": "ghost" } },
        { "id": "same-start-b", "start": "17:00", "end": "17:30", "action": { "type": "loop", "media_id": "bats" } }
      ]
    }
  },
  "cases": [
    { "name": "loop plays inside its window",
      "schedule": "evening", "now": "2026-10-31T01:10:00Z",
      "expect": { "state": "play", "source": "rule:pumpkin-evening", "anchor": "2026-10-31T01:00:00Z",
                  "media_id": "talking-pumpkin", "looping": true, "resume": "restart" } },
    { "name": "one-shot interrupts loop on time",
      "schedule": "evening", "now": "2026-10-31T01:15:02Z",
      "expect": { "state": "play", "source": "rule:ghost-appearance", "anchor": "2026-10-31T01:15:00Z",
                  "media_id": "ghost", "looping": false, "resume": "restart" } },
    { "name": "one-shot more than 5 s late is skipped",
      "schedule": "evening", "now": "2026-10-31T01:15:40Z",
      "expect": { "state": "play", "source": "rule:pumpkin-evening", "anchor": "2026-10-31T01:00:00Z",
                  "media_id": "talking-pumpkin", "looping": true, "resume": "restart" } },
    { "name": "one-shot already playing keeps playing past the grace period",
      "schedule": "evening", "now": "2026-10-31T01:15:20Z",
      "current": { "source": "rule:ghost-appearance", "anchor": "2026-10-31T01:15:00Z" },
      "expect": { "state": "play", "source": "rule:ghost-appearance", "anchor": "2026-10-31T01:15:00Z",
                  "media_id": "ghost", "looping": false, "resume": "restart" } },
    { "name": "loop returns after one-shot ends",
      "schedule": "evening", "now": "2026-10-31T01:15:31Z",
      "current": { "source": "rule:ghost-appearance", "anchor": "2026-10-31T01:15:00Z" },
      "expect": { "state": "play", "source": "rule:pumpkin-evening", "anchor": "2026-10-31T01:00:00Z",
                  "media_id": "talking-pumpkin", "looping": true, "resume": "restart" } },
    { "name": "join_late one-shot starts partway through",
      "schedule": "evening-join-late", "now": "2026-10-31T01:15:20Z",
      "expect": { "state": "play", "source": "rule:ghost-appearance", "anchor": "2026-10-31T01:15:00Z",
                  "media_id": "ghost", "looping": false, "resume": "restart" } },
    { "name": "idle after the window ends",
      "schedule": "evening", "now": "2026-10-31T05:00:00Z",
      "expect": { "state": "idle" } },
    { "name": "idle on a day the rule does not run (Thursday)",
      "schedule": "evening", "now": "2026-10-30T01:10:00Z",
      "expect": { "state": "idle" } },
    { "name": "end_date stops the schedule after that day",
      "schedule": "evening-ended", "now": "2026-11-01T01:10:00Z",
      "expect": { "state": "idle" } },
    { "name": "end_date still allows its last day",
      "schedule": "evening-ended", "now": "2026-10-31T01:10:00Z",
      "expect": { "state": "play", "source": "rule:pumpkin-evening", "anchor": "2026-10-31T01:00:00Z",
                  "media_id": "talking-pumpkin", "looping": true, "resume": "restart" } },
    { "name": "window past midnight belongs to its start day",
      "schedule": "late-night", "now": "2026-11-01T06:30:00Z",
      "expect": { "state": "play", "source": "rule:bats-overnight", "anchor": "2026-11-01T04:00:00Z",
                  "media_id": "bats", "looping": true, "resume": "restart" } },
    { "name": "window survives the repeated DST hour (01:30 MST, second time)",
      "schedule": "late-night", "now": "2026-11-01T08:30:00Z",
      "expect": { "state": "play", "source": "rule:bats-overnight", "anchor": "2026-11-01T04:00:00Z",
                  "media_id": "bats", "looping": true, "resume": "restart" } },
    { "name": "window ends at 02:00 MST after fall-back",
      "schedule": "late-night", "now": "2026-11-01T09:00:00Z",
      "expect": { "state": "idle" } },
    { "name": "equal priority: later start wins",
      "schedule": "overlap", "now": "2026-10-28T02:30:00Z",
      "expect": { "state": "play", "source": "rule:second", "anchor": "2026-10-28T02:00:00Z",
                  "media_id": "bats", "looping": true, "resume": "restart" } },
    { "name": "equal priority and start: earlier rule wins",
      "schedule": "overlap", "now": "2026-10-27T23:10:00Z",
      "expect": { "state": "play", "source": "rule:same-start-a", "anchor": "2026-10-27T23:00:00Z",
                  "media_id": "ghost", "looping": true, "resume": "restart" } },
    { "name": "manual override beats the schedule",
      "schedule": "evening", "now": "2026-10-31T01:10:00Z",
      "override": { "override_id": "ov1", "issued_at": "2026-10-31T01:05:00Z",
                    "action": { "type": "play", "media_id": "scene-x", "loop": true } },
      "expect": { "state": "play", "source": "override:ov1", "anchor": "2026-10-31T01:05:00Z",
                  "media_id": "scene-x", "looping": true, "resume": "restart" } },
    { "name": "override ends at the next rule boundary",
      "schedule": "evening", "now": "2026-10-31T01:15:01Z",
      "override": { "override_id": "ov1", "issued_at": "2026-10-31T01:05:00Z",
                    "action": { "type": "play", "media_id": "scene-x", "loop": true } },
      "expect": { "state": "play", "source": "rule:ghost-appearance", "anchor": "2026-10-31T01:15:00Z",
                  "media_id": "ghost", "looping": false, "resume": "restart" } },
    { "name": "override max duration can end it before the boundary",
      "schedule": "evening", "now": "2026-10-31T01:06:00Z",
      "override": { "override_id": "ov2", "issued_at": "2026-10-31T01:05:00Z", "max_duration_ms": 30000,
                    "action": { "type": "play", "media_id": "scene-x", "loop": true } },
      "expect": { "state": "play", "source": "rule:pumpkin-evening", "anchor": "2026-10-31T01:00:00Z",
                  "media_id": "talking-pumpkin", "looping": true, "resume": "restart" } },
    { "name": "held override ignores rule boundaries",
      "schedule": "evening", "now": "2026-10-31T01:20:00Z",
      "override": { "override_id": "ov3", "issued_at": "2026-10-31T01:05:00Z", "hold": true,
                    "action": { "type": "play", "media_id": "scene-x", "loop": true } },
      "expect": { "state": "play", "source": "override:ov3", "anchor": "2026-10-31T01:05:00Z",
                  "media_id": "scene-x", "looping": true, "resume": "restart" } },
    { "name": "play-once override returns to the schedule when the clip ends",
      "schedule": "evening", "now": "2026-10-31T01:07:01Z",
      "override": { "override_id": "ov4", "issued_at": "2026-10-31T01:05:00Z",
                    "action": { "type": "play", "media_id": "scene-x" } },
      "expect": { "state": "play", "source": "rule:pumpkin-evening", "anchor": "2026-10-31T01:00:00Z",
                  "media_id": "talking-pumpkin", "looping": true, "resume": "restart" } },
    { "name": "stop override shows idle",
      "schedule": "evening", "now": "2026-10-31T01:06:00Z",
      "override": { "override_id": "ov5", "issued_at": "2026-10-31T01:05:00Z", "action": { "type": "stop" } },
      "expect": { "state": "idle", "source": "override:ov5" } },
    { "name": "override with no schedule lasts until cleared",
      "now": "2026-12-25T12:00:00Z",
      "override": { "override_id": "ov6", "issued_at": "2026-10-31T01:05:00Z",
                    "action": { "type": "play", "media_id": "scene-x", "loop": true } },
      "expect": { "state": "play", "source": "override:ov6", "anchor": "2026-10-31T01:05:00Z",
                  "media_id": "scene-x", "looping": true, "resume": "restart" } },
    { "name": "no schedule and no override is idle",
      "now": "2026-10-31T01:10:00Z",
      "expect": { "state": "idle" } }
  ]
}
